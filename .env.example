# ---------------------------------------------------------------------------
# Configuración de la Plataforma de Prospección Inteligente
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` al repo.
# ---------------------------------------------------------------------------

# --- Aplicación ---
APP_NAME="Prospection Platform"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                     # true => logs en formato JSON (producción)

# --- Base de datos (PostgreSQL) ---
# En docker-compose el host es "db". En local usa "localhost".
DATABASE_URL=postgresql+psycopg://prospect:prospect@localhost:5432/prospection

# --- Google Places API ---
GOOGLE_PLACES_API_KEY=""           # deja vacío para usar el proveedor fake en dev
GOOGLE_PLACES_MAX_RESULTS=60
GOOGLE_PLACES_LANGUAGE=es
GOOGLE_PLACES_RATE_LIMIT_PER_SEC=10

# --- Proveedor de IA (LLM) ---
LLM_PROVIDER=openai                # openai | null  (null = salidas deterministas sin API)
OPENAI_API_KEY=""                  # si está vacío se usa el proveedor "null" automáticamente
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=60

# --- Scraping / análisis web ---
WEB_FETCH_TIMEOUT_SECONDS=20
WEB_FETCH_USER_AGENT="ProspectionBot/1.0 (+https://example.com/bot)"
WEB_ANALYSIS_CONCURRENCY=5         # nº máx. de webs analizadas en paralelo
WEB_ANALYSIS_USE_PLAYWRIGHT=true   # false => solo requests (más rápido, sin JS)
WEB_BROKEN_LINKS_MAX_CHECK=25      # nº máx. de enlaces a comprobar por web

# --- Scoring ---
# Ruta opcional a un JSON con pesos personalizados. Vacío => pesos por defecto.
SCORING_CONFIG_PATH=""

# --- Exportación ---
EXPORT_DIR=exports
